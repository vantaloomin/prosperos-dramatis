 "patterns": [
  {
   "id": "em_dash",
   "title": "Em dash in any form",
   "severity": "hard",
   "regex": "—|–|(?<=\\w)--(?=\\w)|\\s--\\s|\\s-\\s"
  },
  {
   "id": "not_x_but_y",
   "title": "\"Not X, but Y\" / \"It wasn't X, it was Y\"",
   "severity": "flag",
   "regex": "\\b(?:not|wasn't|isn't|weren't|wasn't just|isn't just|it wasn't|this wasn't)\\b[^.!?;]{1,60}?,?\\s+(?:but|it was|it's|it is)\\b"
  },
  {
   "id": "triad",
   "title": "Triad rhythm: \"It was X, it was Y, it was Z\"",
   "severity": "flag",
   "regex": "\\b(\\w+ \\w+) [^,.]{1,30}, \\1 [^,.]{1,30}, (?:and )?\\1\\b"
  },
  {
   "id": "place_suffix",
   "title": "Invented place built from a stock suffix",
   "severity": "flag",
   "regex": "\\b[A-Z][a-z]+(?:brook|haven|wood|vale|crest|fall|fell|shire|moor|hold|spire)\\b"
  },
  {
   "id": "synth_quantum",
   "title": "Synth- or Quantum- names",
   "severity": "hard",
   "regex": "\\b(?:Synth|Quantum)[A-Za-z]*\\b"
  },
  {
   "id": "smart_quotes",
   "title": "Smart quotes in plain text",
   "severity": "flag",
   "regex": "[“”‘’]",
   "note": "Only matters where plain text is required."
  }
 ],
 "density": [
  {
   "id": "echo_chamber",
   "title": "Same word 3+ times within 200 words",
   "severity": "flag",
   "window": 200,
   "count": 3
  },
  {
   "id": "punctuation_collapse",
   "title": "500 words with no semicolon, colon, ellipsis or question mark",
   "severity": "flag",
   "window": 500
  },
  {
   "id": "question_free_dialogue",
   "title": "Scene with dialogue but no question mark",
   "severity": "flag"
  }
 ]
}